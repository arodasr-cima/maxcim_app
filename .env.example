# Demonstration mode works without external services.
DEMO_MODE=true
DEMO_EMAIL=docente@maxcim.demo
DEMO_PASSWORD=MaxcimDemo2026!
SEED_DEMO_DATA=true

# Generate a long random value outside demonstration environments.
SECRET_KEY=

# Omit DATABASE_URL to use instance/maxcim_demo.db (SQLite).
# MySQL example: mysql+pymysql://user:password@host:3306/maxcim
DATABASE_URL=

# Optional real Gemini integration. When present, set DEMO_MODE=false.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck

DISPLAY_TIMEZONE=America/Lima
SESSION_COOKIE_SECURE=false
RATELIMIT_ENABLED=true
