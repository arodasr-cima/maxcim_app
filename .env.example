# Demonstration mode works without external services.
DEMO_MODE=true
DEMO_EMAIL=docente@maxcim.demo
DEMO_PASSWORD=MaxcimDemo2026!
SEED_DEMO_DATA=true

# Authentication source: demo, cima or google. Never configure personal credentials here.
AUTH_PROVIDER=demo

# Official CIMA School API (used only when AUTH_PROVIDER=cima).
CIMA_API_BASE_URL=https://apicima.colegiocima.edu.pe:8086
CIMA_API_SYSTEM_ID=21
# The provider must confirm what `identifier` represents. If empty, MAXCIM sends request.remote_addr.
CIMA_API_IDENTIFIER=
# Required in official mode after CIMA confirms the exact stable, unique claim.
CIMA_API_TEACHER_ID_CLAIM=
CIMA_API_TIMEOUT_SECONDS=8
CIMA_API_VERIFY_TLS=true
CIMA_API_SESSION_MAX_AGE_SECONDS=28800
# Generate independently: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CIMA_TOKEN_ENCRYPTION_KEY=
# Keep false outside an explicit local HTTP-only test.
CIMA_ALLOW_INSECURE_LOCAL_COOKIES=false

# Institutional Google Workspace login (used only when AUTH_PROVIDER=google).
# Create a Web application OAuth client and register this exact callback URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/login/google/callback
GOOGLE_WORKSPACE_DOMAIN=colegiocima.edu.pe
# Comma-separated exact teacher emails. A Workspace domain alone also includes students.
GOOGLE_ALLOWED_TEACHER_EMAILS=docente@colegiocima.edu.pe
GOOGLE_OAUTH_FLOW_MAX_AGE_SECONDS=600
GOOGLE_OAUTH_TIMEOUT_SECONDS=10
# Keep false outside an explicit localhost HTTP-only test.
GOOGLE_ALLOW_INSECURE_LOCAL_COOKIES=false

# Generate a long persistent random value outside demonstration environments.
SECRET_KEY=

# Omit DATABASE_URL to use instance/maxcim_demo.db (SQLite).
# MySQL example: mysql+pymysql://user:password@host:3306/maxcim
DATABASE_URL=

# Optional real Gemini integration. When present, set DEMO_MODE=false.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck

DISPLAY_TIMEZONE=America/Lima
SESSION_COOKIE_SECURE=false
RATELIMIT_ENABLED=true
