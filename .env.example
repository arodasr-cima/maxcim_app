# Flask
DEMO_MODE=true
# Si queda vacío, el entorno de pruebas genera una clave temporal al arrancar
# (solo con DEMO_MODE=true). Con DEMO_MODE=false hace falta un valor fijo,
# o cada reinicio invalida las sesiones abiertas.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_TOKEN_ENCRYPTION_KEY=

# Base aislada de pruebas. SQLite funciona sin instalar MySQL.
DEMO_DATABASE_URL=sqlite:///maxcim_demo.db

# Para MySQL persistente, define DATABASE_URL. Las variables MYSQL_* solo se
# usan con DEMO_MODE=false y se incluyen por compatibilidad.
# Ejemplo: mysql+pymysql://usuario:contrasena@127.0.0.1:3306/maxcim_app?charset=utf8mb4
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=maxcim_app

# API institucional CIMA. DEMO_MODE no realiza llamadas a esta API, así que
# estos valores solo se usan si pruebas localmente con DEMO_MODE=false.
# Login (usuario/contraseña) confirmado contra la API real; ver
# probar_conexion.py y docs/integration-contract.md sección 3.1.
INSTITUTIONAL_API_BASE_URL=https://apicima.colegiocima.edu.pe:8086
INSTITUTIONAL_API_LOGIN_PATH=/api/v2/authentication/with/user
# idSystem con el que CIMA identifica a MAXCIM como sistema consumidor.
INSTITUTIONAL_API_ID_SYSTEM=21
INSTITUTIONAL_API_GOOGLE_LOGIN_PATH=/v1/auth/google
# Confirmado contra la API real: el path param es idLogueo (no idPersona).
INSTITUTIONAL_API_CLASSROOMS_PATH=/api/v2/gradesection/list/group/user/{login_id}
# URL documentada por CIMA para alumnos por aula (respuesta aún sin
# verificar contra datos reales, a diferencia de login y aulas).
INSTITUTIONAL_API_STUDENTS_PATH=/api/v2/studentschool/list/gradesectiongroup/{classroom_id}/type/{section_type}/order/{order}
INSTITUTIONAL_API_STUDENT_PATH=/v1/students/{person_id}
INSTITUTIONAL_API_SERVICE_TOKEN=
INSTITUTIONAL_API_TIMEOUT_SECONDS=8
INSTITUTIONAL_API_VERIFY_TLS=true

# Google Workspace opcional. DEMO_MODE ofrece acceso local de un clic.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Uno o varios dominios separados por coma; no permite cuentas personales.
GOOGLE_OAUTH_ALLOWED_DOMAINS=
# En producción: https://tu-dominio/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_TIMEOUT_SECONDS=8

# Gemini. Obtén la clave en https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck

# Integración MAXCIM (autentica al robot frente a /api/materials y /api/interacciones)
MAXCIM_WEBHOOK_SECRET=cambia-este-secreto-compartido
